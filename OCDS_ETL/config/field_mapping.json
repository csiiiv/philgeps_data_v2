{
  "field_mapping_version": 1,
  "status": "draft",
  "input": "DATA_NORMALIZATION/output/philgeps_cleaned.parquet",
  "ocds_version": "1.1.5",
  "historical_reference": {
    "repository": "https://github.com/csiiiv/philgeps-ocds-schema-analysis",
    "commit": "269a19b7288125814baa6aabf30d33ebf9c12a1a",
    "files": [
      "references/PHILGEPS_CANONICAL_FIELD_MAP.json",
      "references/PHILGEPS_OCDS_CSV_CROSSWALK.md",
      "references/philgeps-1.5.json",
      "references/mphilgeps.json",
      "references/ocds_reference.json"
    ],
    "authority": "design_input_only"
  },
  "policies": {
    "preserve_source_values": true,
    "unresolved_values": "retain_in_analytical_parquet_and_block_publication",
    "currency": "pending_confirmation",
    "timezone": "pending_confirmation",
    "party_name_resolution": "post_split_versioned_transformation"
  },
  "fields": {
    "_source_file_id": {"targets": ["record_sources.source_file_id"], "treatment": "direct", "status": "accepted"},
    "_source_sheet": {"targets": ["record_sources.source_sheet"], "treatment": "direct", "status": "accepted"},
    "_source_row_number": {"targets": ["record_sources.source_row_number"], "treatment": "direct", "status": "accepted"},
    "_source_schema_id": {"targets": ["record_sources.source_schema_id"], "treatment": "direct_local", "status": "accepted"},
    "bid_reference_no": {"targets": ["contracting_processes.source_process_identifier", "tenders.source_bid_reference"], "treatment": "identity_rule_and_copy", "status": "accepted"},
    "solicitation_no": {"targets": ["tenders.solicitation_number"], "treatment": "direct", "status": "accepted"},
    "notice_title": {"targets": ["tenders.title"], "treatment": "direct", "status": "accepted"},
    "bid_published_date": {"targets": ["tenders.date_published", "releases.release_date_evidence"], "treatment": "direct_naive_timestamp", "status": "accepted"},
    "classification": {"targets": ["tenders.main_procurement_category", "tenders.source_classification"], "treatment": "codelist_and_source", "status": "accepted"},
    "notice_type": {"targets": ["tenders.source_notice_type"], "treatment": "direct_local", "status": "accepted"},
    "business_category": {"targets": ["tenders.business_category"], "treatment": "direct_local", "status": "accepted"},
    "funding_source": {"targets": ["tenders.funding_source"], "treatment": "direct_local", "status": "accepted"},
    "funding_instrument": {"targets": ["tenders.funding_instrument"], "treatment": "direct_local", "status": "accepted"},
    "procurement_mode": {"targets": ["tenders.procurement_method", "tenders.procurement_method_details"], "treatment": "codelist_and_source", "status": "accepted"},
    "trade_agreement": {"targets": ["tenders.trade_agreement"], "treatment": "direct_local", "status": "accepted"},
    "approved_budget": {"targets": ["tenders.value_amount"], "treatment": "direct_decimal", "status": "accepted"},
    "area_of_delivery": {"targets": ["tenders.area_of_delivery"], "treatment": "direct_local", "status": "accepted"},
    "contract_duration": {"targets": ["tenders.source_contract_duration", "tenders.contract_duration_days"], "treatment": "copy_and_safe_day_conversion", "status": "accepted"},
    "calendar_type": {"targets": ["tenders.source_calendar_type", "tenders.contract_duration_unit"], "treatment": "codelist_and_source", "status": "accepted"},
    "prebid_date": {"targets": ["tenders.prebid_date"], "treatment": "direct_naive_timestamp", "status": "accepted"},
    "closing_date": {"targets": ["tenders.closing_date"], "treatment": "direct_naive_timestamp", "status": "accepted"},
    "bid_notice_status": {"targets": ["tenders.status", "tenders.source_status"], "treatment": "codelist_and_source", "status": "accepted"},
    "line_item_no": {"targets": ["tender_items.source_line_item_number"], "treatment": "identity_rule_and_copy", "status": "accepted"},
    "item_name": {"targets": ["tender_items.title"], "treatment": "direct_local", "status": "accepted"},
    "item_description": {"targets": ["tender_items.description"], "treatment": "direct", "status": "accepted"},
    "quantity": {"targets": ["tender_items.quantity"], "treatment": "direct_decimal", "status": "accepted"},
    "unit_of_measurement": {"targets": ["tender_items.unit_name"], "treatment": "direct", "status": "accepted"},
    "item_budget": {"targets": ["tender_items.item_budget_amount"], "treatment": "direct_local_pending_semantics", "status": "accepted"},
    "unspsc_code": {"targets": ["tender_items.classification_id"], "treatment": "direct_string", "status": "accepted"},
    "unspsc_description": {"targets": ["tender_items.classification_description"], "treatment": "direct", "status": "accepted"},
    "award_reference_no": {"targets": ["awards.source_award_reference"], "treatment": "identity_rule_and_copy", "status": "accepted"},
    "award_title": {"targets": ["awards.title"], "treatment": "direct", "status": "accepted"},
    "award_type": {"targets": ["awards.source_award_type"], "treatment": "direct_local", "status": "accepted"},
    "award_date": {"targets": ["awards.date"], "treatment": "direct_naive_timestamp", "status": "accepted"},
    "award_published_date": {"targets": ["awards.date_published", "releases.release_date_evidence"], "treatment": "direct_naive_timestamp", "status": "accepted"},
    "contract_amount": {"targets": ["awards.value_amount", "contracts.value_amount"], "treatment": "copy_with_semantics_flag", "status": "accepted"},
    "award_notice_status": {"targets": ["awards.status", "awards.source_status"], "treatment": "codelist_and_source", "status": "accepted"},
    "reason_for_award": {"targets": ["awards.description"], "treatment": "direct", "status": "accepted"},
    "contract_no": {"targets": ["contracts.source_contract_number"], "treatment": "identity_rule_and_copy", "status": "accepted"},
    "notice_to_proceed_date": {"targets": ["contracts.notice_to_proceed_date"], "treatment": "direct_local_naive_timestamp", "status": "accepted"},
    "contract_effectivity_date": {"targets": ["contracts.period_start"], "treatment": "direct_naive_timestamp", "status": "accepted"},
    "contract_end_date": {"targets": ["contracts.period_end"], "treatment": "direct_naive_timestamp", "status": "accepted"},
    "procuring_entity_name": {"targets": ["parties.name", "party_roles.procuringEntity"], "treatment": "source_party_mention", "status": "accepted"},
    "procuring_entity_name_key": {"targets": ["parties.name_key"], "treatment": "conservative_key", "status": "accepted"},
    "client_agency": {"targets": ["parties.name", "party_roles.buyer_candidate"], "treatment": "source_party_mention", "status": "unresolved"},
    "client_agency_key": {"targets": ["parties.name_key"], "treatment": "conservative_key", "status": "accepted"},
    "awardee_organization_name": {"targets": ["parties.name", "party_roles.supplier", "award_suppliers.source_supplier_label"], "treatment": "source_party_mention", "status": "accepted"},
    "awardee_organization_name_key": {"targets": ["parties.name_key"], "treatment": "conservative_key", "status": "accepted"},
    "awardee_contact_person": {"targets": ["parties.contact_name"], "treatment": "analytical_only_pending_privacy", "status": "unresolved"},
    "awardee_joint_venture": {"targets": ["parties.source_joint_venture", "award_suppliers.source_joint_venture"], "treatment": "preserve_unparsed", "status": "unresolved"},
    "procuring_entity_region": {"targets": ["parties.source_region"], "treatment": "direct_pending_psgc", "status": "accepted"},
    "procuring_entity_province": {"targets": ["parties.source_province"], "treatment": "direct_pending_psgc", "status": "accepted"},
    "procuring_entity_city_municipality": {"targets": ["parties.source_city_municipality"], "treatment": "direct_pending_psgc", "status": "accepted"},
    "government_branch": {"targets": ["parties.government_branch"], "treatment": "direct_local", "status": "accepted"},
    "procuring_entity_organization_type": {"targets": ["parties.source_organization_type"], "treatment": "direct_local", "status": "accepted"},
    "procuring_entity_organization_type_grouped": {"targets": ["parties.organization_type_grouped"], "treatment": "direct_local", "status": "accepted"},
    "awardee_country": {"targets": ["parties.source_country"], "treatment": "direct_pending_address_normalization", "status": "accepted"},
    "awardee_region": {"targets": ["parties.source_region"], "treatment": "direct_pending_psgc", "status": "accepted"},
    "awardee_province": {"targets": ["parties.source_province"], "treatment": "direct_pending_psgc", "status": "accepted"},
    "awardee_city_municipality": {"targets": ["parties.source_city_municipality"], "treatment": "direct_pending_psgc", "status": "accepted"},
    "awardee_size": {"targets": ["parties.organization_size"], "treatment": "direct_local", "status": "accepted"},
    "created_by": {"targets": ["releases.source_created_by"], "treatment": "analytical_only", "status": "accepted"},
    "_extra_values": {"targets": ["data_quality_issues.observed_value"], "treatment": "quality_evidence", "status": "accepted"},
    "_replacement_character_columns": {"targets": ["data_quality_issues.observed_value"], "treatment": "quality_evidence", "status": "accepted"},
    "_cleaning_issues": {"targets": ["data_quality_issues.issue_code"], "treatment": "quality_evidence", "status": "accepted"},
    "_cleaning_issue_count": {"targets": ["data_quality_issues.source_issue_count"], "treatment": "quality_evidence", "status": "accepted"}
  }
}

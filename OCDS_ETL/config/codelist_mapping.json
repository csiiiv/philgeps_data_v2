        "Civil Works": {"destination_value": "works", "status": "accepted"},
        "Consulting Services": {"destination_value": "services", "status": "accepted"},
        "Goods - General Support Services": {"destination_value": "services", "status": "proposed", "rationale": "The source label is classified under goods administratively but describes services; confirm policy before publication."},
        "Undefined": {"destination_value": null, "status": "unresolved"}
      }
    },
    "procurement_mode": {

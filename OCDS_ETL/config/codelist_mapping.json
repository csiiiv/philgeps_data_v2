        "Shopping": {"destination_value": "limited", "status": "proposed"},
        "Shopping - Ordinary/Regular Office Supplies & Equipment (Sec. 52.1.b)": {"destination_value": "limited", "status": "proposed"},
        "Shopping - Unforeseen Contingency (Sec. 52.1.a)": {"destination_value": "limited", "status": "proposed"},
        "Selection based on Consultants Qualification": {"destination_value": "selective", "status": "proposed"},
        "Negotiated Procurement": {"destination_value": null, "status": "unresolved"},

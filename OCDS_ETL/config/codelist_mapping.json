    },
    "award_notice_status": {
      "destination": "awards.status",
      "closed_codelist": true,
      "values": {
        "Posted": {"destination_value": "active", "status": "accepted"},
        "Updated": {"destination_value": "active", "status": "accepted"},
        "Cancelled": {"destination_value": "cancelled", "status": "accepted"},
        "For Approval": {"destination_value": "pending", "status": "accepted"}

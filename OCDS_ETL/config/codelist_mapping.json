        "Negotiated Procurement - Two Failed Biddings (Sec. 53.1)": {"destination_value": null, "status": "unresolved"},
        "Negotiated Procurement - Emergency Cases (Sec. 53.2)": {"destination_value": null, "status": "unresolved"},
        "Negotiated Procurement - Agency to Agency (Sec. 53.5)": {"destination_value": "direct", "status": "proposed"},
        "NP - Scientific, Scholarly/Artistic Work, Exclusive Tech. & Media Service (53.6)": {"destination_value": null, "status": "unresolved"},
        "Negotiated Procurement - Procurement Agent (Sec. 53.6)": {"destination_value": null, "status": "unresolved"},
        "Negotiated Procurement - Highly Technical Consultants (Sec. 53.7)": {"destination_value": null, "status": "unresolved"},
        "Negotiated Procurement - Defense Cooperation Agreement (Sec. 53.8)": {"destination_value": null, "status": "unresolved"},
        "Negotiated Procurement - Lease of Real Property (Sec. 53.10)": {"destination_value": null, "status": "unresolved"},
        "Negotiated Procurement - NGO Participation (Sec. 53.11)": {"destination_value": null, "status": "unresolved"},
        "Negotiated Procurement - Community Participation (Sec. 53.12)": {"destination_value": null, "status": "unresolved"},
        "Negotiated Procurement - United Nations Agencies (Sec. 53.13)": {"destination_value": "direct", "status": "proposed"},
        "Local Purchase": {"destination_value": null, "status": "unresolved"},
        "Renewal of Regular and Recurring Sevices per Appendix 37": {"destination_value": null, "status": "unresolved"},
        "Undefined": {"destination_value": null, "status": "unresolved"}
      }
    },
    "bid_notice_status": {
      "destination": "tender.status",
      "closed_codelist": true,
      "values": {
        "Active": {"destination_value": "active", "status": "accepted"},
        "Awarded": {"destination_value": "complete", "status": "accepted"},
        "Failed": {"destination_value": "unsuccessful", "status": "accepted"},
        "Cancelled": {"destination_value": "cancelled", "status": "accepted"},
        "Closed": {"destination_value": "complete", "status": "proposed"},
        "Shortlisted": {"destination_value": "active", "status": "proposed"},
        "Closed - Pending Opening": {"destination_value": "active", "status": "proposed"},
        "Disapproved": {"destination_value": "withdrawn", "status": "proposed"}

    "calendar_type": {
      "destination": "tenders.contract_duration_unit",
      "closed_codelist": false,
      "values": {
        "Day/s": {"destination_value": "day", "status": "accepted", "safe_duration_in_days": true},
        "Month/s": {"destination_value": "month", "status": "accepted", "safe_duration_in_days": false},
        "Year/s": {"destination_value": "year", "status": "accepted", "safe_duration_in_days": false}
